<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.sijunyang.bracketpairguides</id>
    <name>Bracket Pair Guides</name>
    <vendor url="https://github.com/YangSiJun528">sijun-yang</vendor>

    <description><![CDATA[
        <p>Colorizes matching brackets by nesting level and shows an active guide for the innermost pair containing the caret.</p>
        <p>Uses the IntelliJ Platform's language brace-matching extension. Select language families and customize colors, guide lines, and active-pair emphasis in Editor settings.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <highlightingPassFactory
                implementation="com.sijunyang.bracketpairguides.editor.highlighting.BracketGuidePassRegistration"/>

        <applicationService
                serviceImplementation="com.sijunyang.bracketpairguides.settings.BracketGuideSettings"/>

        <applicationConfigurable
                parentId="editor"
                instance="com.sijunyang.bracketpairguides.settings.ui.BracketGuideSettingsPage"
                id="com.sijunyang.bracketpairguides.settings.PluginConfigurable"
                displayName="Bracket Pair Guides"/>
    </extensions>
</idea-plugin>
