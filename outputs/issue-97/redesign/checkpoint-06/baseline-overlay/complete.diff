+import groovy.json.JsonOutput
+import org.gradle.api.tasks.bundling.Jar
+import org.gradle.api.tasks.bundling.Zip
+import org.gradle.api.tasks.TaskProvider
+import java.security.MessageDigest
+import java.util.zip.ZipFile
+
+// Opt-in only. No ordinary build file, production source, old test or reviewed image changes.
+gradle.projectsEvaluated {
+    if (System.getProperty('issue97.driver.counterfactual') != 'true') {
+        throw new GradleException('Explicit -Dissue97.driver.counterfactual=true required')
+    }
+    def plugin = gradle.rootProject.project(':plugin')
+    def root = plugin.file('counterfactual-driver')
+    def bridge = plugin.sourceSets.create('counterfactualBridge')
+    def driver = plugin.sourceSets.create('counterfactualDriver')
+    plugin.kotlin.sourceSets.getByName('counterfactualBridge').kotlin.setSrcDirs([new File(root, 'bridge/kotlin')])
+    plugin.kotlin.sourceSets.getByName('counterfactualDriver').kotlin.setSrcDirs([new File(root, 'driver/kotlin')])
+    bridge.compileClasspath += plugin.configurations.testCompileClasspath + plugin.sourceSets.main.output
+    bridge.runtimeClasspath += plugin.configurations.testRuntimeClasspath + plugin.sourceSets.main.output
+    driver.compileClasspath += plugin.sourceSets.visualTest.compileClasspath
+    driver.runtimeClasspath += plugin.sourceSets.visualTest.runtimeClasspath - plugin.sourceSets.visualTest.output
+    plugin.tasks.named('compileCounterfactualBridgeKotlin').configure {
+        // Baseline already exposes its module internals to integration tests only.
+        compilerOptions.freeCompilerArgs.addAll(plugin.tasks.named('compileTestKotlin').get().compilerOptions.freeCompilerArgs)
+    }
+    def bridgeJar = plugin.tasks.register('counterfactualDriverBridgeJar', Jar) {
+        archiveFileName.set('counterfactual-driver-bridge.jar')
+        destinationDirectory.set(plugin.layout.buildDirectory.dir('counterfactual-driver/bridge'))
+        // Classes/own Kotlin metadata only: generated source-set plugin.xml must not enter this helper JAR.
+        from(bridge.output.classesDirs)
+    }
+    def release = plugin.tasks.named('buildPlugin')
+    def archive = plugin.tasks.register('buildCounterfactualDriverPlugin', Zip) {
+        archiveFileName.set('baseline-counterfactual-driver.zip')
+        destinationDirectory.set(plugin.layout.buildDirectory.dir('counterfactual-driver/distributions'))
+        from(plugin.zipTree(release.flatMap { it.archiveFile }))
+        from(bridgeJar) { into("${gradle.rootProject.name}/lib") }
+        dependsOn(release, bridgeJar)
+        doLast {
+            def readEntries = { File file ->
+                new ZipFile(file).withCloseable { zip ->
+                    def entries = Collections.list(zip.entries())
+                    if (entries*.name.toSet().size() != entries.size()) throw new GradleException("Duplicate archive entries: $file")
+                    entries.collectEntries { entry -> [(entry.name): zip.getInputStream(entry).withCloseable { it.bytes }] }
+                }
+            }
+            def original = readEntries(release.get().archiveFile.get().asFile)
+            def combined = readEntries(archiveFile.get().asFile)
+            def bridgeFile = bridgeJar.get().archiveFile.get().asFile
+            def extra = "${gradle.rootProject.name}/lib/${bridgeFile.name}"
+            if (combined.keySet() != original.keySet() + [extra]) throw new GradleException('Counterfactual ZIP must add exactly one bridge JAR to baseline release')
+            original.each { name, bytes ->
+                if (!Arrays.equals(bytes, combined[name])) throw new GradleException("Baseline release entry changed: $name")
+            }
+            if (!Arrays.equals(bridgeFile.bytes, combined[extra])) throw new GradleException('Bridge JAR bytes changed in composed ZIP')
+            def bridgeEntries = readEntries(bridgeFile)
+            def classes = bridgeEntries.keySet().findAll { it.endsWith('.class') }.sort()
+            if (classes.empty || classes.any { !it.startsWith('com/sijunyang/bracketpairguides/testing/EditorContractBridge') }) {
+                throw new GradleException("Unexpected bridge classes: $classes")
+            }
+            def digest = { File file -> MessageDigest.getInstance('SHA-256').digest(file.bytes).encodeHex().toString() }
+            def evidence = [schema: 1, scope: 'baseline072533f release plus additive newbridge only; diagnostic capture, not visual pass',
+                releaseArchive: release.get().archiveFile.get().asFile.absolutePath,
+                releaseSha256: digest(release.get().archiveFile.get().asFile),
+                composedArchive: archiveFile.get().asFile.absolutePath, composedSha256: digest(archiveFile.get().asFile),
+                bridgeArchive: bridgeFile.absolutePath, bridgeSha256: digest(bridgeFile),
+                addedEntries: [extra], allReleaseEntriesByteEqual: true, bridgeClasses: classes]
+            def out = plugin.layout.buildDirectory.file('counterfactual-driver/archive-evidence.json').get().asFile
+            out.parentFile.mkdirs()
+            out.text = JsonOutput.prettyPrint(JsonOutput.toJson(evidence)) + '\n'
+        }
+    }
+    plugin.tasks.named('visualTest').configure {
+        testClassesDirs = driver.output.classesDirs
+        classpath = driver.runtimeClasspath
+        filter.setIncludePatterns('com.sijunyang.bracketpairguides.visual.EditorVisualContractTest')
+        archiveFile.set(archive.flatMap { it.archiveFile })
+        dependsOn(archive, driver.output)
+        // Existing ordinary visual output/recording tasks are not part of this diagnostic invocation.
+        setDependsOn(getDependsOn().findAll { dependency ->
+            !(dependency instanceof TaskProvider && dependency.name in ['cleanVisualTestArtifacts', 'buildVisualTestPlugin'])
+        })
+        systemProperty('visual.test.capture-candidates', 'true')
+        def output = System.getProperty('issue97.driver.output')
+        if (output == null || !new File(output).isAbsolute()) throw new GradleException('Absolute fresh -Dissue97.driver.output required')
+        systemProperty('visual.test.artifacts.dir', new File(output, 'artifacts').absolutePath)
+        def projectDirectory = plugin.layout.buildDirectory.dir('visual-test-project').get().asFile
+        systemProperty('visual.test.project.dir', projectDirectory.absolutePath)
+        doFirst {
+            if (System.getenv('CI') == 'true') throw new GradleException('Diagnostic capture-only counterfactual is forbidden with CI=true')
+            if (projectDirectory.exists() && projectDirectory.list().length != 0) throw new GradleException('Counterfactual project directory must be absent or empty in the fresh Docker workspace')
+            def artifacts = new File(output, 'artifacts')
+            if (artifacts.exists() && artifacts.list().length != 0) throw new GradleException('Refusing stale counterfactual capture directory')
+            logger.lifecycle('COUNTERFACTUAL DIAGNOSTIC CAPTURE ONLY: assertions remain enabled; no reviewed image updates or visual-pass claim')
+        }
+    }
+}
