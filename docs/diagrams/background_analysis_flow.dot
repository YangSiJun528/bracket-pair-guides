digraph BackgroundAnalysisFlow {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.35,
        nodesep=0.35,
        ranksep=0.48,
        splines=polyline,
        compound=true,
        fontname="Arial",
        fontsize=18,
        label="Highlighting pass — background analysis and EDT publication",
        labelloc=t
    ];
    node [
        shape=box,
        style="rounded,filled",
        color="#52606D",
        fillcolor="#FFFFFF",
        fontname="Arial",
        fontsize=10,
        margin="0.14,0.09"
    ];
    edge [
        color="#52606D",
        fontcolor="#334E68",
        fontname="Arial",
        fontsize=9,
        arrowsize=0.72
    ];

    start [shape=circle, label="", width=0.22, fillcolor="#455A64"];

    subgraph cluster_background {
        label="BGT — IntelliJ highlighting read action";
        color="#6C8EBF";
        fillcolor="#EEF5FF";
        style="rounded,filled";

        capture [label="Capture AnalysisInput\n(document revision, highlighter, file type,\ncoverage, languages, tab size)"];
        too_large [shape=diamond, label="IDE code-insight\nsize limit?"];
        accepted [shape=diamond, label="Same request already\ncomplete or refused?"];
        recognize [label="DocumentBrackets.recognize\nscan HighlighterIterator tokens"];
        recognition_ok [shape=diamond, label="Authoritative pair table?"];
        assemble [label="SnapshotAssembly\nbuild only requested indexes"];
        guide_cap [shape=diamond, label="Requested guide index\nfits exact capacity?"];

        size_unavailable [label="Unavailable\nIDE_CODE_INSIGHT_FILE_SIZE", fillcolor="#FDECEC", color="#C44E52"];
        structure_unavailable [label="Unavailable\nPAIR_CAPACITY or PENDING_OPEN_CAPACITY\n(no partial pair prefix)", fillcolor="#FDECEC", color="#C44E52"];
        limited [label="Limited\nexact lower snapshot, guide-position index omitted", fillcolor="#FFF4D6", color="#C58B00"];
        complete [label="Complete\nexact requested snapshot", fillcolor="#E6F6EA", color="#3A8F5B"];
        no_result [label="No new result\nkeep accepted state", fillcolor="#F3F6F8"];
    }

    thread_handoff [shape=box, style="rounded,dashed,filled", label="IntelliJ switches to EDT\ndoApplyInformationToEditor", fillcolor="#FFF0E2", color="#D97706"];

    subgraph cluster_edt {
        label="EDT — validate, publish, and update markup";
        color="#D97706";
        fillcolor="#FFF8EE";
        style="rounded,filled";

        recheck_size [shape=diamond, label="Current file now\ntoo large?"];
        collected_size_refusal [shape=diamond, label="Collected result was\nIDE size refusal?"];
        current [shape=diamond, label="Collected stamp still\nmatches editor + settings?"];
        install [label="Install/find EditorGuideSession\nfor this Editor view"];
        accept [shape=diamond, label="Outcome kind"];
        publish_complete [label="Complete\npublish exact requested facets", fillcolor="#E6F6EA", color="#3A8F5B"];
        publish_limited [label="Limited\npublish exact lower facets; multiline indexed guide absent", fillcolor="#FFF4D6", color="#C58B00"];
        publish_unavailable [label="Unavailable\nremember refusal; clear stale markup", fillcolor="#FDECEC", color="#C44E52"];
        drop_size_outcome [label="Drop collected size outcome\ncurrent file has recovered", fillcolor="#F3F6F8"];
        discard [label="Discard stale result\ncurrent presentation wins", fillcolor="#F3F6F8"];
        repaint [label="Request editor repaint\nIntelliJ later calls BracketGuideDrawing.paint"];
    }

    finish [shape=doublecircle, label="", width=0.22, fillcolor="#455A64"];

    start -> capture;
    capture -> too_large;
    too_large -> size_unavailable [label="yes"];
    too_large -> accepted [label="no"];
    accepted -> no_result [label="yes"];
    accepted -> recognize [label="no"];
    recognize -> recognition_ok;
    recognition_ok -> structure_unavailable [label="no"];
    recognition_ok -> assemble [label="yes"];
    assemble -> guide_cap;
    guide_cap -> limited [label="no"];
    guide_cap -> complete [label="yes / not requested"];

    {size_unavailable structure_unavailable limited complete no_result} -> thread_handoff;
    thread_handoff -> recheck_size;
    recheck_size -> install [label="yes\nforce current size refusal"];
    recheck_size -> collected_size_refusal [label="no"];
    collected_size_refusal -> drop_size_outcome [label="yes"];
    drop_size_outcome -> current [label="validate captured stamp"];
    collected_size_refusal -> current [label="no"];
    current -> discard [label="no"];
    current -> install [label="yes"];
    install -> accept;
    accept -> publish_complete [label="Complete"];
    accept -> publish_limited [label="Limited"];
    accept -> publish_unavailable [label="Unavailable"];
    accept -> finish [label="no new result"];
    {publish_complete publish_limited publish_unavailable} -> repaint;
    {repaint discard} -> finish;
}
