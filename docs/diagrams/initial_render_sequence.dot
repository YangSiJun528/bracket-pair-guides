digraph InitialRenderSequence {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.30,
        nodesep=0.48,
        ranksep=0.48,
        splines=polyline,
        fontname="Arial",
        fontsize=18,
        label="Initial analysis and rendering sequence",
        labelloc=t
    ];
    node [fontname="Arial", fontsize=9];
    edge [fontname="Arial", fontsize=8, arrowsize=0.65];

    ide_h [shape=box, style="rounded,filled", fillcolor="#F3F6F8", label="IntelliJ\ndaemon/editor"];
    reg_h [shape=box, style="rounded,filled", fillcolor="#EAF2FF", label="Pass\nregistration"];
    pass_h [shape=box, style="rounded,filled", fillcolor="#EAF2FF", label="Highlighting\npass"];
    analysis_h [shape=box, style="rounded,filled", fillcolor="#EAF2FF", label="BracketAnalysis\n[APP service]"];
    assembly_h [shape=box, style="rounded,filled", fillcolor="#F4ECFF", label="Snapshot\nassembly"];
    recognition_h [shape=box, style="rounded,filled", fillcolor="#F4ECFF", label="Recognition +\npairing core"];
    session_h [shape=box, style="rounded,filled", fillcolor="#EAF7E7", label="EditorGuideSession\n[one Editor]"];
    present_h [shape=box, style="rounded,filled", fillcolor="#EAF7E7", label="Presentation +\ndrawing"];

    { rank=same; ide_h; reg_h; pass_h; analysis_h; assembly_h; recognition_h; session_h; present_h; }
    ide_h -> reg_h -> pass_h -> analysis_h -> assembly_h -> recognition_h -> session_h -> present_h [style=invis, weight=100];

    node [shape=point, width=0.025, height=0.025, label="", color="#90A4AE"];

    { rank=same; ide1; reg1; pass1; analysis1; assembly1; recognition1; session1; present1; }
    { rank=same; ide2; reg2; pass2; analysis2; assembly2; recognition2; session2; present2; }
    { rank=same; ide3; reg3; pass3; analysis3; assembly3; recognition3; session3; present3; }
    { rank=same; ide4; reg4; pass4; analysis4; assembly4; recognition4; session4; present4; }
    { rank=same; ide5; reg5; pass5; analysis5; assembly5; recognition5; session5; present5; }
    { rank=same; ide6; reg6; pass6; analysis6; assembly6; recognition6; session6; present6; }
    { rank=same; ide7; reg7; pass7; analysis7; assembly7; recognition7; session7; present7; }
    { rank=same; ide8; reg8; pass8; analysis8; assembly8; recognition8; session8; present8; }
    { rank=same; ide9; reg9; pass9; analysis9; assembly9; recognition9; session9; present9; }
    { rank=same; ide10; reg10; pass10; analysis10; assembly10; recognition10; session10; present10; }
    { rank=same; ide11; reg11; pass11; analysis11; assembly11; recognition11; session11; present11; }
    { rank=same; ide12; reg12; pass12; analysis12; assembly12; recognition12; session12; present12; }
    { rank=same; ide13; reg13; pass13; analysis13; assembly13; recognition13; session13; present13; }
    { rank=same; ide14; reg14; pass14; analysis14; assembly14; recognition14; session14; present14; }

    ide1 -> reg1 -> pass1 -> analysis1 -> assembly1 -> recognition1 -> session1 -> present1 [style=invis, weight=100];
    ide2 -> reg2 -> pass2 -> analysis2 -> assembly2 -> recognition2 -> session2 -> present2 [style=invis, weight=100];
    ide3 -> reg3 -> pass3 -> analysis3 -> assembly3 -> recognition3 -> session3 -> present3 [style=invis, weight=100];
    ide4 -> reg4 -> pass4 -> analysis4 -> assembly4 -> recognition4 -> session4 -> present4 [style=invis, weight=100];
    ide5 -> reg5 -> pass5 -> analysis5 -> assembly5 -> recognition5 -> session5 -> present5 [style=invis, weight=100];
    ide6 -> reg6 -> pass6 -> analysis6 -> assembly6 -> recognition6 -> session6 -> present6 [style=invis, weight=100];
    ide7 -> reg7 -> pass7 -> analysis7 -> assembly7 -> recognition7 -> session7 -> present7 [style=invis, weight=100];
    ide8 -> reg8 -> pass8 -> analysis8 -> assembly8 -> recognition8 -> session8 -> present8 [style=invis, weight=100];
    ide9 -> reg9 -> pass9 -> analysis9 -> assembly9 -> recognition9 -> session9 -> present9 [style=invis, weight=100];
    ide10 -> reg10 -> pass10 -> analysis10 -> assembly10 -> recognition10 -> session10 -> present10 [style=invis, weight=100];
    ide11 -> reg11 -> pass11 -> analysis11 -> assembly11 -> recognition11 -> session11 -> present11 [style=invis, weight=100];
    ide12 -> reg12 -> pass12 -> analysis12 -> assembly12 -> recognition12 -> session12 -> present12 [style=invis, weight=100];
    ide13 -> reg13 -> pass13 -> analysis13 -> assembly13 -> recognition13 -> session13 -> present13 [style=invis, weight=100];
    ide14 -> reg14 -> pass14 -> analysis14 -> assembly14 -> recognition14 -> session14 -> present14 [style=invis, weight=100];

    ide_h -> ide1 -> ide2 -> ide3 -> ide4 -> ide5 -> ide6 -> ide7 -> ide8 -> ide9 -> ide10 -> ide11 -> ide12 -> ide13 -> ide14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    reg_h -> reg1 -> reg2 -> reg3 -> reg4 -> reg5 -> reg6 -> reg7 -> reg8 -> reg9 -> reg10 -> reg11 -> reg12 -> reg13 -> reg14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    pass_h -> pass1 -> pass2 -> pass3 -> pass4 -> pass5 -> pass6 -> pass7 -> pass8 -> pass9 -> pass10 -> pass11 -> pass12 -> pass13 -> pass14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    analysis_h -> analysis1 -> analysis2 -> analysis3 -> analysis4 -> analysis5 -> analysis6 -> analysis7 -> analysis8 -> analysis9 -> analysis10 -> analysis11 -> analysis12 -> analysis13 -> analysis14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    assembly_h -> assembly1 -> assembly2 -> assembly3 -> assembly4 -> assembly5 -> assembly6 -> assembly7 -> assembly8 -> assembly9 -> assembly10 -> assembly11 -> assembly12 -> assembly13 -> assembly14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    recognition_h -> recognition1 -> recognition2 -> recognition3 -> recognition4 -> recognition5 -> recognition6 -> recognition7 -> recognition8 -> recognition9 -> recognition10 -> recognition11 -> recognition12 -> recognition13 -> recognition14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    session_h -> session1 -> session2 -> session3 -> session4 -> session5 -> session6 -> session7 -> session8 -> session9 -> session10 -> session11 -> session12 -> session13 -> session14 [style=dashed, arrowhead=none, color="#B0BEC5"];
    present_h -> present1 -> present2 -> present3 -> present4 -> present5 -> present6 -> present7 -> present8 -> present9 -> present10 -> present11 -> present12 -> present13 -> present14 [style=dashed, arrowhead=none, color="#B0BEC5"];

    ide1 -> reg1 [xlabel="1  load registrar extension", color="#52606D", fontcolor="#334E68", constraint=false];
    reg2 -> ide2 [xlabel="2  register highlighting pass factory", style=dashed, color="#52606D", fontcolor="#334E68", constraint=false];
    ide3 -> reg3 [xlabel="3  create pass(file, editor) [BGT]", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    reg4 -> pass4 [xlabel="4  new pass(analyze callback)", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    ide5 -> pass5 [xlabel="5  doCollectInformation(progress) [BGT]", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    pass6 -> analysis6 [xlabel="6  analyze(input, progress)", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    analysis7 -> assembly7 [xlabel="7  outcome()", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    assembly8 -> recognition8 [xlabel="8  recognize token stream", color="#3B6EA8", fontcolor="#3B6EA8", constraint=false];
    recognition9 -> assembly9 [xlabel="9  PairTable or capacity refusal", style=dashed, color="#3A8F5B", fontcolor="#3A8F5B", constraint=false];
    assembly10 -> pass10 [xlabel="10  Complete / Limited / Unavailable", style=dashed, color="#3A8F5B", fontcolor="#3A8F5B", constraint=false];
    ide11 -> pass11 [xlabel="11  doApplyInformationToEditor() [EDT]", color="#D97706", fontcolor="#B85C00", penwidth=2, constraint=false];
    pass12 -> session12 [xlabel="12  accept(current outcome) [EDT]", color="#D97706", fontcolor="#B85C00", penwidth=2, constraint=false];
    session13 -> present13 [xlabel="13  replace active pair, tokens, guide", color="#D97706", fontcolor="#B85C00", penwidth=2, constraint=false];
    present14 -> ide14 [xlabel="14  highlighters + repaint; IDE calls paint", style=dashed, color="#D97706", fontcolor="#B85C00", constraint=false];

}
